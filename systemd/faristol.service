[Unit]
Description=Faristol - Banc de Treball de Lectura i Síntesi Bibliogràfica
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/faristol
ExecStart=/usr/bin/python3 -m uvicorn faristol.server:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/Projects/faristol
# Configuració local (fora del repositori, sense valors personals al codi):
# llista blanca d'amfitrions, ruta de nlm, directoris MCP... Vegeu
# systemd/faristol.env.example. El prefix '-' fa que el fitxer siga opcional.
EnvironmentFile=-%h/.config/faristol/faristol.env

[Install]
WantedBy=default.target
