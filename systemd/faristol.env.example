# -----------------------------------------------------------------------------
# Configuració local de Faristol (plantilla)
#
# Copia este fitxer a  ~/.config/faristol/faristol.env  i ajusta'l a la teua
# xarxa. L'instal·lador (install.sh) ja el crea automàticament si no existeix.
# El servei el llig gràcies a:
#   EnvironmentFile=-%h/.config/faristol/faristol.env
#
# NOTA: systemd NO expandix '~' ni variables dins d'un EnvironmentFile;
# fes servir sempre rutes absolutes.
# -----------------------------------------------------------------------------

# Autenticació per sessió (opcional). Si definixes usuari I contrasenya,
# Faristol exigix iniciar sessió (cookie HttpOnly de 30 dies, «Recorda'm»).
# Si no els definixes, l'accés queda Obert (comportament retrocompatible).
# FARISTOL_AUTH_USER=el_teu_usuari
# FARISTOL_AUTH_PASSWORD=la_teua_contrasenya

# Secret de signatura de les sessions. Si no el definixes, se'n genera un
# d'aleatori la primera vegada i es guarda a ~/.config/faristol/session_secret.
# FARISTOL_SESSION_SECRET=canvia-aquest-valor

# Durada de la sessió en dies (per defecte 30).
# FARISTOL_SESSION_DAYS=30

# Marca la cookie com a Secure (NOMÉS si servixes Faristol per HTTPS).
# FARISTOL_COOKIE_SECURE=0

# Llista blanca d'amfitrions accessibles (protecció DNS rebinding / CSRF).
# Afig-hi el nom de l'equip, la IP de la LAN i la IP/domini de Tailscale,
# separats per comes. S'admet el comodí '*.domini'.
# Si no es defineix, només s'accepten les adreces locals (127.0.0.1, localhost).
FARISTOL_ALLOWED_HOSTS=127.0.0.1,localhost,*.ts.net

# Ruta de l'executable de NotebookLM (opcional). Per defecte es busca al PATH i,
# si no hi és, a ~/.local/bin/nlm.
# FARISTOL_NLM_BIN=/home/EL_TEU_USUARI/.local/bin/nlm

# Directoris dels servidors MCP locals opcionals (projectes germans).
# FARISTOL_MCP_OPEN_DATA_DIR=/home/EL_TEU_USUARI/Projects/mcp-server-open-data-spain
# FARISTOL_MCP_REAL_ESTATE_DIR=/home/EL_TEU_USUARI/Projects/mcp-server-real-estate-spain
# FARISTOL_MCP_ACADEMIC_DIR=/home/EL_TEU_USUARI/Projects/mcp-server-academic-spain

# Ubicacions de dades (opcional). Per defecte: ~/Documents/... i ~/.config/faristol.
# FARISTOL_DOCS_DIR=/home/EL_TEU_USUARI/Documents
# FARISTOL_CONFIG_DIR=/home/EL_TEU_USUARI/.config/faristol
