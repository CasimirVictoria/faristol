[Unit]
Description=Faristol - Banc de Treball de Lectura i Síntesi Bibliogràfica
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/faristol
ExecStart=/usr/bin/python3 -m uvicorn faristol.server:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/Projects/faristol

[Install]
WantedBy=default.target
